{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi Web",
  "version": "0.12.2",
  "identifier": "ai.pi.web.desktop",
  "build": {
    "frontendDist": "loading"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pi Web",
        "width": 1366,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["resources/pi-web", "resources/node"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
